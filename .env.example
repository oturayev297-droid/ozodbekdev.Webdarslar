# ============================================================
# NAMUNA. Nusxa oling: cp .env.example .env
# Productionda qiymatlarni albatta o'zgartiring!
# ============================================================

# Yangi kalit generatsiya qilish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=bu-yerga-yangi-kalit-qoying

# Productionda ALBATTA False
DJANGO_DEBUG=False

# Domeningiz (vergul bilan)
DJANGO_ALLOWED_HOSTS=example.uz,www.example.uz

# PostgreSQL (bo'sh qoldirilsa SQLite ishlatiladi)
DATABASE_URL=postgres://foydalanuvchi:parol@localhost:5432/stitch_db

# nginx X-Accel-Redirect orqali himoyalangan video uzatish
USE_X_ACCEL_REDIRECT=True

# Email (parolni tiklash kodlari)
# Gmail uchun App Password (16 belgi): https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sizning@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
DEFAULT_FROM_EMAIL=Nexus <sizning@gmail.com>

# Telegram xabarnomalar (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=123456789:AAEhBOweik6ad9r_QXZ2rMt1Uu4yBHMxx
TELEGRAM_BOT_USERNAME=ozodbekweb_bot
# To'lov so'rovlari haqida xabar oladigan adminlar (vergul bilan)
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321
# Webhook manzilidagi maxfiy qism (tasodifiy satr)
TELEGRAM_WEBHOOK_SECRET=uzun-tasodifiy-satr

# To'lov tizimlari (merchant kabinetidan olinadi)
PAYME_MERCHANT_ID=5e730e8e0b852a417aa49ceb
PAYME_KEY=hRnSmpxGYt%J&Kj@8CkPMBmwXfPU7Uz
# Payme kabinetida sozlangan maydon nomi
PAYME_ACCOUNT_FIELD=order_id

CLICK_SERVICE_ID=12345
CLICK_MERCHANT_ID=6789
CLICK_SECRET_KEY=abcdefghijklmnop

# AI Mentor (Claude API) — https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — tushuntirish uchun low yetarli va arzon
ANTHROPIC_EFFORT=low

# ==========================================================================
# Frontend alohida deploy qilinganda (Vercel + Railway)
# ==========================================================================
#
# FRONTEND_ORIGINS — frontend qaysi manzillardan keladi. Vergul bilan.
# Vercel `rewrites` ishlatilsa (tavsiya etiladi) bu KERAK EMAS: so'rov
# backendga o'z domenidan kelayotgandek ko'rinadi.
#
# To'g'ridan-to'g'ri murojaat qilinsa to'ldiring:
# FRONTEND_ORIGINS=https://oson.vercel.app,https://oson.uz
FRONTEND_ORIGINS=
FRONTEND_URL=

# ==========================================================================
# Video ombori — S3 mos bulut (Cloudflare R2, AWS S3, Backblaze B2)
# ==========================================================================
#
# BO'SH BO'LSA eski yo'l ishlaydi (nginx X-Accel-Redirect yoki lokal fayl).
#
# RAILWAY UCHUN MAJBURIY: u yerda fayl tizimi vaqtinchalik va nginx yo'q.
# Bucket OCHIQ BO'LMASLIGI kerak — kirish faqat imzolangan havola bilan.
#
# R2 endpoint ko'rinishi:
#   https://<account_id>.r2.cloudflarestorage.com
VIDEO_STORAGE_BUCKET=
VIDEO_STORAGE_ENDPOINT=
VIDEO_STORAGE_ACCESS_KEY=
VIDEO_STORAGE_SECRET_KEY=
VIDEO_STORAGE_REGION=auto
