# ============================================================
# NAMUNA. Nusxa oling: cp .env.example .env
# Productionda qiymatlarni albatta o'zgartiring!
# ============================================================

# Yangi kalit generatsiya qilish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=bu-yerga-yangi-kalit-qoying

# Productionda ALBATTA False
DJANGO_DEBUG=False

# Domeningiz (vergul bilan)
DJANGO_ALLOWED_HOSTS=example.uz,www.example.uz

# PostgreSQL (bo'sh qoldirilsa SQLite ishlatiladi)
DATABASE_URL=postgres://foydalanuvchi:parol@localhost:5432/stitch_db

# nginx X-Accel-Redirect orqali himoyalangan video uzatish
USE_X_ACCEL_REDIRECT=True

# Email (parolni tiklash kodlari)
# Gmail uchun App Password (16 belgi): https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sizning@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
DEFAULT_FROM_EMAIL=Nexus <sizning@gmail.com>
