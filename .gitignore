# Repozitoriy ikki mustaqil qismdan iborat:
#
#   backend/   Django + DRF  -> Railway (Root Directory = backend)
#   frontend/  Next.js       -> Vercel  (Root Directory = frontend)
#
# Ular alohida joylashtiriladi va bir-birining fayllarini bilmaydi.
# Bog'lanish faqat HTTP orqali: frontend `NEXT_PUBLIC_BACKEND_URL` ga
# so'rov yuboradi.

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.log
backend/logs/
local_settings.py
backend/db.sqlite3
backend/db.sqlite3.backup
backend/media/
backend/staticfiles/
*.sql
*.dump

# --- Muhit o'zgaruvchilari ---
# Backend maxfiy qiymatlari FAQAT backend/.env da. Ilgari ular ildizda
# turardi va frontend bilan bitta joyda aralashib ketardi.
.env
backend/.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDE ---
.vscode
.idea

# --- Frontend (Next.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.vercel
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo
